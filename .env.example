# 免费AI工具站（自部署版）环境变量示例
#
# 使用方法：复制本文件为 .env，填入真实值后启动服务。
#   cp .env.example .env
# 注意：.env 包含密钥，绝不要提交到仓库（已在 .gitignore 中忽略）。
# 也可以不填 .env，直接在「设置」页录入各家 Key（设置页写入 data/settings.json，
# 优先级高于环境变量）。

# 服务监听端口（本地默认 8080；Cloud Run 等平台会自动注入 PORT）
PORT=8080

# 访问密码（可选）：不填则公开访问，任何人打开就能用；
# 填了则打开应用要先输密码登录，未登录调 /api/* 接口返回 401，
# 生成的成品文件（/blobs/*）同样需要登录才能打开。
# 登录会话是服务端内存里的随机 token，进程重启后需重新登录。
# 例外：GET /api/health 不设防，供 Cloud Run 等平台健康检查用。
ACCESS_PASSWORD=YOUR_ACCESS_PASSWORD_HERE

# ---- 限流（按 IP，每分钟滑动窗口；计数只存在服务端内存里，重启即清零）----
# 生成类重操作（出图、生视频、对话、识图、翻译、语音合成、语音转文字、向量、
# 供应商连通性测试、备份导入）每 IP 每分钟上限，默认 60；设为 0 关闭生成类限流。
# 非整数或负数会被忽略（回落到默认值并记一条 warn 日志），服务照常启动。
RATE_LIMIT_PER_MINUTE=60
# 查询类接口（所有 GET 接口、删除会话、保存供应商凭据）每 IP 每分钟上限，
# 默认 300；设为 0 关闭查询类限流。
# 健康检查（GET /api/health）不限流；登录（POST /api/login）走单独的登录限流，见下。
RATE_LIMIT_QUERY_PER_MINUTE=300

# ---- 登录限流（防密码猜测；只计失败次数，成功登录清零）----
# 同一 IP 在窗口内最多失败次数，默认 5；设为 0 关闭登录限流。
LOGIN_MAX_ATTEMPTS=5
# 登录限流窗口（分钟），默认 15。
LOGIN_WINDOW_MINUTES=15

# 数据目录：历史记录、会话、设置、生成文件都存在这里（相对路径相对于项目根目录）
# 仅本地存储后端（STORAGE_BACKEND=local）使用；S3 后端的数据存在对象存储桶里。
DATA_DIR=./data

# ---- 存储后端（历史/会话/设置/生成文件的存放位置）----
# local（默认）：存在本地 DATA_DIR 目录；s3：存在 S3 兼容对象存储。
# Cloud Run 等无状态平台必须用 s3 后端，否则实例重建或缩到 0 后数据会丢失。
# 注意：STORAGE_BACKEND=s3 但下面 4 个必填项缺任何一个，服务启动即失败
# （不会静默回落到本地，那样会造成数据已持久化的错觉）。
STORAGE_BACKEND=local
# S3 兼容存储配置（STORAGE_BACKEND=s3 时必填；以 Cloudflare R2 为例）
# 申请：登录 Cloudflare 控制台 https://dash.cloudflare.com → 左侧 R2 Object Storage
# → Create bucket 建一个桶（如 free-ai-tool-station-data），再在 R2 → Manage R2 API
# Tokens 创建 API Token（需 Object Read & Write 权限），得到 Access Key 与 Secret Key。
# S3_ENDPOINT 为 R2 的 S3 API 地址，形如 https://<账号ID>.r2.cloudflarestorage.com，
# 在桶详情页的 S3 API 一栏可找到；R2 免费档含 10GB 存储且零出口费。
# 其他 S3 兼容存储（如 AWS S3、GCS 互通、本地 MinIO）同样适用，填对应端点即可。
S3_ENDPOINT=YOUR_S3_ENDPOINT_HERE
S3_BUCKET=YOUR_S3_BUCKET_HERE
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=YOUR_S3_SECRET_KEY_HERE
# S3_REGION：R2 填 auto；AWS S3 填桶所在区域，如 us-east-1
S3_REGION=auto
# 寻址方式：默认 virtual-hosted style（R2、GCS 互通、AWS S3 都用这个）；
# endpoint 是 localhost 或 IP 地址时自动用 path-style；设为 true 可强制 path-style。
S3_FORCE_PATH_STYLE=false

# ---- InstaBox 免费机（出图后端之一，ComfyUI CPU 模式）----
# InstaBox 代理地址，如 https://<端口>-<机器ID>.instabox.tech
# 申请：注册 InstaBox 免费账号并创建一台免费机器后，自行部署 ComfyUI + 代理。
# 官网：https://instabox.tech
INSTABOX_PROXY_URL=YOUR_INSTABOX_PROXY_URL_HERE

# ---- Kaggle（出图/生视频 GPU 后端）----
# Kaggle 用户名
# 申请：注册 Kaggle 账号后，在个人主页查看用户名。
# 官网：https://www.kaggle.com
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME_HERE
# Kaggle API Key（Legacy API Key）
# 申请：登录 Kaggle → 头像 → Settings → API → Create New Token，
# 下载的 kaggle.json 里的 key 即为此值。
KAGGLE_KEY=YOUR_KAGGLE_API_KEY_HERE
# Kaggle 出图 kernel 的 slug（默认即可；改了 kernel 名才需要改）
KAGGLE_FLUX_SLUG=free-ai-tool-station-flux
# Kaggle 生视频 kernel 的 slug（默认即可；改了 kernel 名才需要改）
KAGGLE_VIDEO_SLUG=free-ai-tool-station-wan-video

# ---- Cloudflare Workers AI（出图/对话/翻译/语音/向量）----
# Cloudflare 账号 ID
# 申请：登录 Cloudflare 控制台，右侧栏 Account ID 即是。
# 官网：https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
# Workers AI API Token（需要 Workers AI 读写权限）
# 申请：Cloudflare 控制台 → My Profile → API Tokens → Create Token，
# 模板选 Workers AI 相关权限，或自定义 Token 授予 Account: Workers AI: Edit。
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE

# ---- Groq（对话 / 语音转文字）----
# Groq API Key
# 申请：注册 Groq 账号后，在控制台 API Keys 页创建。
# 官网：https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# ---- 智谱 z.ai（对话 / 识图）----
# z.ai API Key（智谱国际版，GLM Flash 系列模型免费）
# 申请：注册 z.ai 账号后，在控制台 API Key 管理页创建。
# 官网：https://z.ai
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE

# ---- DeepL（翻译）----
# DeepL API Key（API Free 计划，Key 以 :fx 结尾）
# 申请：注册 DeepL 账号，选择 API Free（Developer）计划后在账号页获取。
# 官网：https://www.deepl.com
DEEPL_API_KEY=YOUR_DEEPL_API_KEY_HERE

# ---- ElevenLabs（语音合成 TTS）----
# ElevenLabs API Key
# 申请：注册 ElevenLabs 账号后，在 Profile → API Keys 页创建。
# 官网：https://elevenlabs.io
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# ---- 硅基流动 SiliconFlow（识图 OCR / 翻译 / 语音转文字 / 向量）----
# 硅基流动 API Key
# 申请：注册硅基流动账号后，在控制台 API 密钥页创建。
# 官网：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE

# ---- Google Gemini（对话 / 识图）----
# Gemini API Key（Flash / Flash-Lite 模型免费档可用）
# 申请：登录 Google AI Studio，在 API Keys 页创建。
# 官网：https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---- NVIDIA NIM（对话）----
# NVIDIA NIM API Key（免费试用：免绑卡，约 40 请求/分钟，仅限试用评估）
# 申请：注册 NVIDIA 开发者账号后，在 build.nvidia.com 的 API Keys 页创建（Key 以 nvapi- 开头）。
# 官网：https://build.nvidia.com
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
